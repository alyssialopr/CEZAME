{
  "expo": {
    "name": "Cezame",
    "slug": "Cezame",
    "version": "1.0.0",
    "description": "Apprends à gérer tes démarches administratives, ta santé, ton budget, ton logement et ta mobilité grâce à des leçons courtes, ludiques et interactives.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cezame",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#0F172A",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBFAF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "name": "Cezame — Maîtrise tes démarches et ta vie d'adulte",
      "shortName": "Cezame",
      "lang": "fr",
      "description": "Apprends à gérer tes démarches administratives, ta santé, ton budget, ton logement et ta mobilité grâce à des leçons courtes, ludiques et interactives.",
      "themeColor": "#0F172A",
      "backgroundColor": "#FBFAF8",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF8",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 96
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
