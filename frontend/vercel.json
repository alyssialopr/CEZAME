{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(favicon\\.png|logo\\.png|apple-touch-icon\\.png|og-image\\.png|manifest\\.json|robots\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_expo|assets|favicon\\.png|favicon\\.ico|logo\\.png|apple-touch-icon\\.png|og-image\\.png|manifest\\.json|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
